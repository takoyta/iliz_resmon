// VERSIONINFO: iliz_updater reads ProductVersion to compare with the latest GitHub release.
#include <winver.h>
#include "version.h"

1 VERSIONINFO
FILEVERSION     APP_VERSION_NUM
PRODUCTVERSION  APP_VERSION_NUM
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "takoyta\0"
            VALUE "FileDescription",  "iliz resmon\0"
            VALUE "FileVersion",      APP_VERSION_A "\0"
            VALUE "InternalName",     "iliz_resmon\0"
            VALUE "LegalCopyright",   "MIT License\0"
            VALUE "OriginalFilename", "iliz_resmon.exe\0"
            VALUE "ProductName",      "iliz resmon\0"
            VALUE "ProductVersion",   APP_VERSION_A "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
