#pragma code_page(65001)
#include <windows.h>
#include "config.h"
#include "../src/version.h"

1 24 "config.manifest"

IDD_MAIN DIALOGEX 0, 0, 200, 149
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "iliz resmon: settings"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    GROUPBOX        "Tray icons", IDC_GROUP, 7, 5, 186, 79
    AUTOCHECKBOX    "CPU", IDC_CPU, 16, 18, 150, 10
    AUTOCHECKBOX    "Memory", IDC_MEM, 16, 31, 150, 10
    AUTOCHECKBOX    "Disks", IDC_DISK, 16, 44, 150, 10
    AUTOCHECKBOX    "Network", IDC_NET, 16, 57, 150, 10
    AUTOCHECKBOX    "GPU (video card)", IDC_GPU, 16, 70, 150, 10
    LTEXT           "Update interval:", IDC_INTERVAL_LBL, 10, 93, 120, 10
    COMBOBOX        IDC_INTERVAL, 133, 91, 60, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Process rows in popups:", IDC_TOPN_LBL, 10, 110, 120, 10
    COMBOBOX        IDC_TOPN, 133, 108, 60, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "Start with Windows", IDC_AUTO, 10, 127, 120, 10
    DEFPUSHBUTTON   "Close", IDOK, 143, 125, 50, 14
END

1 VERSIONINFO
FILEVERSION     APP_VERSION_NUM
PRODUCTVERSION  APP_VERSION_NUM
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "takoyta\0"
            VALUE "FileDescription",  "iliz resmon settings\0"
            VALUE "FileVersion",      APP_VERSION_A "\0"
            VALUE "InternalName",     "iliz_resmon_config\0"
            VALUE "LegalCopyright",   "MIT License\0"
            VALUE "OriginalFilename", "iliz_resmon_config.exe\0"
            VALUE "ProductName",      "iliz resmon\0"
            VALUE "ProductVersion",   APP_VERSION_A "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
